# Copy this file to `.env` to run Trial By Argument OUTSIDE the Claude platform.
#
# Your Anthropic API key. Used only server-side by the bundled proxy
# (server/proxy-middleware.js) — it is never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional transport overrides (auto-detected by default):
#   - On localhost the proxy is used automatically.
#   - On the Claude platform the direct call is used automatically.
# Force one explicitly if needed:
# VITE_FORCE_PROXY=true
# VITE_FORCE_PLATFORM=true

# Optional: change the proxy path the client posts to (must match the server).
# VITE_PROXY_PATH=/api/messages
